<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>EventLogMonitor.Configurator</AssemblyName>
    <RootNamespace>EventLogMonitor.Configurator</RootNamespace>
    <Version>1.2.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\EventLogMonitor\EventLogMonitor.csproj" />
    <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.12" />
  </ItemGroup>

  <Target Name="CopyServiceRuntimeDependencies" AfterTargets="Build">
    <ItemGroup>
      <ServiceRuntimeFiles Include="..\EventLogMonitor\bin\$(Configuration)\$(TargetFramework)\runtimes\win\lib\net10.0\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(ServiceRuntimeFiles)" DestinationFolder="$(OutDir)runtimes\win\lib\net10.0" SkipUnchangedFiles="true" Condition="'@(ServiceRuntimeFiles)' != ''" />
  </Target>
</Project>
