{
  "EventLogMonitor": {
    "Logs": [
      "Application",
      "System",
      "Security"
    ],
    "Rules": [
      {
        "Name": "Generic application crashes (optional)",
        "Enabled": false,
        "LogName": "Application",
        "EventIds": [
          1000,
          1001
        ],
        "Providers": [],
        "Levels": [],
        "MessageRegex": "",
        "CooldownSeconds": 60,
        "NotifyEmail": true,
        "NotifySms": false
      },
      {
        "Name": "Unexpected service termination",
        "Enabled": true,
        "LogName": "System",
        "EventIds": [
          7031,
          7034
        ],
        "Providers": [
          "Service Control Manager"
        ],
        "Levels": [],
        "MessageRegex": "",
        "CooldownSeconds": 60,
        "NotifyEmail": true,
        "NotifySms": false
      },
      {
        "Name": "Failed Windows logon",
        "Enabled": false,
        "LogName": "Security",
        "EventIds": [
          4625
        ],
        "Providers": [
          "Microsoft-Windows-Security-Auditing"
        ],
        "Levels": [],
        "MessageRegex": "",
        "CooldownSeconds": 300,
        "NotifyEmail": true,
        "NotifySms": false
      },
      {
        "Name": "IIS – WAS application pool failures",
        "Enabled": true,
        "LogName": "System",
        "EventIds": [
          5002,
          5011,
          5059
        ],
        "Providers": [],
        "Levels": [
          "Error",
          "Warning"
        ],
        "MessageContains": "",
        "MessageRegex": "",
        "ApplicationPools": [],
        "CooldownSeconds": 60,
        "NotifyEmail": true,
        "NotifySms": false
      },
      {
        "Name": "ASP.NET application errors",
        "Enabled": true,
        "LogName": "Application",
        "EventIds": [
          1309
        ],
        "Providers": [],
        "Levels": [
          "Error",
          "Warning"
        ],
        "MessageContains": "",
        "MessageRegex": "",
        "ApplicationPools": [],
        "CooldownSeconds": 60,
        "NotifyEmail": true,
        "NotifySms": false
      },
      {
        "Name": ".NET Runtime unhandled exceptions",
        "Enabled": true,
        "LogName": "Application",
        "EventIds": [
          1026
        ],
        "Providers": [
          ".NET Runtime"
        ],
        "Levels": [
          "Error"
        ],
        "MessageContains": "",
        "MessageRegex": "",
        "ApplicationPools": [],
        "CooldownSeconds": 60,
        "NotifyEmail": true,
        "NotifySms": false
      },
      {
        "Name": "IIS worker process crashes (w3wp.exe)",
        "Enabled": true,
        "LogName": "Application",
        "EventIds": [
          1000,
          1001
        ],
        "Providers": [],
        "Levels": [],
        "MessageContains": "w3wp.exe",
        "MessageRegex": "",
        "ApplicationPools": [],
        "CooldownSeconds": 60,
        "NotifyEmail": true,
        "NotifySms": false
      },
      {
        "Name": "ASP.NET Core Module errors",
        "Enabled": true,
        "LogName": "Application",
        "EventIds": [],
        "Providers": [
          "IIS AspNetCore Module",
          "IIS AspNetCore Module V2",
          "IIS Express AspNetCore Module"
        ],
        "Levels": [
          "Error",
          "Warning"
        ],
        "MessageContains": "",
        "MessageRegex": "",
        "ApplicationPools": [],
        "CooldownSeconds": 60,
        "NotifyEmail": true,
        "NotifySms": false
      }
    ]
  },
  "Notifications": {
    "Email": {
      "Enabled": false,
      "SmtpHost": "smtp.example.com",
      "SmtpPort": 587,
      "EnableSsl": true,
      "UserName": "",
      "Password": "",
      "From": "event-monitor@example.com",
      "To": [
        "admin@example.com"
      ]
    },
    "SmsWebhook": {
      "Enabled": false,
      "Url": "https://localhost:7166/api/sms/webhook",
      "Method": "POST",
      "ContentType": "application/json",
      "PhoneNumbers": [
        "+15551234567",
        "+15557654321"
      ],
      "BodyTemplate": "{\"message\":{{message}},\"phoneNumbers\":{{phoneNumbersJson}},\"subject\":{{subject}},\"rule\":{{rule}},\"machine\":{{machine}},\"log\":{{log}},\"eventId\":{{eventId}},\"provider\":{{provider}},\"time\":{{time}}}",
      "Headers": {}
    }
  }
}
